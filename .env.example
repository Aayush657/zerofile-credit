# Copy to .env. Nothing here is needed to run the app, only to retrain.

# Where the raw dataset is stored. Defaults to ./data
SAAKH_DATA_DIR=data

# The public dataset currently downloads without a login. If Kaggle starts asking for one,
# create a free API token at https://www.kaggle.com/settings and fill these in.
KAGGLE_USERNAME=
KAGGLE_KEY=
